<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ar_ui_enhancements" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.ar.ui.enhancements</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting
                    id="l10n_ar_consumer_final_identification_amount_setting"
                    string="Consumidor final"
                    help="Desde este monto la factura de cliente a consumidor final exige identificacion fiscal. Por debajo se permite usar Sin Identificar (SIGD)."
                    invisible="country_code != 'AR'"
                >
                    <field name="l10n_ar_consumer_final_identification_amount"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
