<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_latam_doc_l10n_ar_ui_enhancements" model="ir.ui.view">
        <field name="name">account.move.form.l10n.latam.doc.l10n.ar.ui.enhancements</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="attributes">
                <attribute name="required">partner_id and l10n_latam_use_documents and not l10n_ar_partner_config_warning</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_number']" position="attributes">
                <attribute name="required">partner_id and l10n_latam_use_documents and l10n_latam_manual_document_number and not l10n_ar_partner_config_warning</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_l10n_ar_ui_enhancements" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ar.ui.enhancements</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or not show_reset_to_draft_button</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_credit_warning']/.." position="after">
                <div class="alert alert-danger" role="alert" invisible="not l10n_ar_partner_config_warning">
                    <field name="l10n_ar_partner_config_warning" nolabel="1" readonly="1"/>
                    <span> </span>
                    <button
                        type="object"
                        name="action_open_partner_for_completion"
                        string="Corrijalo desde aqui"
                        class="oe_link"
                        style="padding: 0; vertical-align: baseline;"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
